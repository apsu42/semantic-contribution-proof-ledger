{
  "name": "bap-semantic-contribution-proof-ledger",
  "version": "0.1.0",
  "private": true,
  "license": "CC0-1.0",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "hardhat compile",
    "test": "node --test test/interface-ids.test.js test/package-tooling.test.js && hardhat test test/conformance.hardhat.test.js test/settlement-invariants.hardhat.test.js test/adversarial-tokens.hardhat.test.js",
    "typecheck": "tsc --noEmit",
    "check:selectors": "node scripts/check-selectors.mjs",
    "check:interface-ids": "node scripts/check-interface-ids.mjs",
    "check:spec-parity": "node scripts/check-spec-parity.mjs"
  },
  "nx": {
    "includedScripts": []
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.3.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@types/node": "22.15.30",
    "ethers": "6.14.3",
    "hardhat": "2.24.2",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "keccak"
    ],
    "onlyBuiltDependencies": [
      "secp256k1"
    ]
  }
}
